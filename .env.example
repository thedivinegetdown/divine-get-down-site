# Analytics stays disabled until a provider, privacy review, and consent decision
# are approved through a separate Execution Order.
REACT_APP_ANALYTICS_ENABLED=false

# Error monitoring is production-only and remains inert until a provider is
# approved and connected through a separate Execution Order.
REACT_APP_ERROR_MONITORING_ENABLED=false
REACT_APP_RELEASE=

# Verification tokens are public identifiers supplied by each webmaster tool.
REACT_APP_GOOGLE_SITE_VERIFICATION=
REACT_APP_BING_SITE_VERIFICATION=
